@* @page *@
@* @model ActivityDetailsModel *@
@* *@
@* @{ *@
@*     ViewData["Title"] = "Calendar"; *@
@* } *@
@* *@
@* <!DOCTYPE html> *@
@* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"> *@
@* <html> *@
@* <head> *@
@*     <title>Beskrivelse af de enkelte aktiviteter</title> *@
@*     <div class="text-center mt-4"> *@
@*     </div> *@
@* </head> *@
@* <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script> *@
@* *@
@* <div class="container my-5" style="max-width: 800px;"> *@
@*     <!-- Tilbageknap --> *@
@*     <div class="mb-4"> *@
@*         <a asp-page="/Calendar" class="btn btn-outline-success fw-bold px-4 shadow-sm"> *@
@*             ← Tilbage til Ugeskemaet *@
@*         </a> *@
@*     </div> *@
@* *@
@*     <!-- Hovedkort for aktiviteten --> *@
@*     <div class="card shadow border-0 overflow-hidden"> *@
@*         <!-- Grøn Spejder-Header --> *@
@*         <div class="card-header bg-success text-white p-4"> *@
@*             <div class="d-flex justify-content-between align-items-center flex-wrap"> *@
@*                 <div> *@
@*                     <span class="badge bg-light text-success fw-bold text-uppercase px-3 py-2 mb-2 shadow-sm"> *@
@*                         🏕️ Aktivitet Info *@
@*                     </span> *@
@*                     <h1 class="display-5 fw-bold mb-0 text-white">@Model.at.Name</h1> *@
@*                 </div> *@
@*                 <div class="text-end mt-2 mt-md-0"> *@
@*                     <span class="fs-4 d-block fw-semibold">📅 @Model.at.DayOfWeek</span> *@
@*                     <span class="badge bg-white text-dark px-3 py-2 mt-1 shadow-sm">🕒 @Model.at.TimeSlot</span> *@
@*                 </div> *@
@*             </div> *@
@*         </div> *@
@* *@
@*         <!-- Kortets Indhold --> *@
@*         <div class="card-body p-4 bg-white"> *@
@*             <!-- Beskrivelse --> *@
@*             <div class="mb-5"> *@
@*                 <h4 class="fw-bold text-success border-bottom pb-2">📋 Beskrivelse</h4> *@
@*                 <p class="fs-5 text-secondary text-wrap" style="line-height: 1.6;"> *@
@*                     @Model.Activity.Description *@
@*                 </p> *@
@*             </div> *@
@* *@
@*             <!-- Praktisk Information Gitter --> *@
@*             <div class="row g-4 mb-5"> *@
@*                 <h4 class="fw-bold text-success border-bottom pb-2 mb-3">⚙️ Praktisk Information</h4> *@
@*                  *@
@*                 <!-- Alderskrav --> *@
@*                 <div class="col-sm-6"> *@
@*                     <div class="p-3 bg-light rounded-3 border d-flex align-items-center"> *@
@*                         <div class="fs-2 me-3">👶</div> *@
@*                         <div> *@
@*                             <small class="text-muted d-block text-uppercase fw-bold">Minimumsalder</small> *@
@*                             <span class="fs-4 fw-bold text-dark">@Model.Activity.MinimumAge år</span> *@
@*                         </div> *@
@*                     </div> *@
@*                 </div> *@
@* *@
@*                 <!-- Kapacitet --> *@
@*                 <div class="col-sm-6"> *@
@*                     <div class="p-3 bg-light rounded-3 border d-flex align-items-center"> *@
@*                         <div class="fs-2 me-3">👥</div> *@
@*                         <div> *@
@*                             <small class="text-muted d-block text-uppercase fw-bold">Max Deltagere</small> *@
@*                             <span class="fs-4 fw-bold text-dark">@Model.Activity.MaxParticipantNumber pladser</span> *@
@*                         </div> *@
@*                     </div> *@
@*                 </div> *@
@*             </div> *@
@* *@
@*             <!-- Tilmeldte Spejdere Sektion --> *@
@*             <div class="mt-4 p-4 rounded-3 border bg-light"> *@
@*                 <div class="d-flex justify-content-between align-items-center mb-3"> *@
@*                     <h5 class="fw-bold text-dark mb-0">🪵 Tilmeldte spejdere</h5> *@
@*                     <span class="badge bg-success fs-6 px-3"> *@
@*                         @Model.Activity.Users.Count / @Model.Activity.MaxParticipantNumber tilmeldt *@
@*                     </span> *@
@*                 </div> *@
@* *@
@*                 @if (Model.Activity.Users != null && Model.Activity.Users.Any()) *@
@*                 { *@
@*                     <div class="d-flex flex-wrap gap-2 pt-2"> *@
@*                         @foreach (var user in Model.Activity.users) *@
@*                         { *@
@*                             <span class="fs-6 badge bg-white text-dark border border-success p-2 px-3 shadow-sm rounded-pill"> *@
@*                                 ⚜️ @user.Name *@
@*                             </span> *@
@*                         } *@
@*                     </div> *@
@*                 } *@
@*                 else *@
@*                 { *@
@*                     <p class="text-muted fst-italic mb-0 py-2"> *@
@*                         Ingen spejdere har tilmeldt sig denne aktivitet endnu. *@
@*                     </p> *@
@*                 } *@
@*             </div> *@
@*         </div> *@
@*     </div> *@
@* </div> *@