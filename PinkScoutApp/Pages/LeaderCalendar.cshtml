@page
@model LeaderCalendarModel

@{
    ViewData["Title"] = "Calendar";
}

<!DOCTYPE html>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<html>

<head>
    <title>LeaderCalendar</title>
</head>

<body>
</body>

</html>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<style>
    /* Gør cellerne bredere på mindre skærme, så tabellen ikke bliver mast */
    @@media screen and (max-width: 992px) {

        .scout-table th,
        .scout-table td {
            min-width: 130px;
        }
    }
    
    /* Giver aktivitetskortene en flot animation, når man holder musen over dem */
    .activity-link {
        text-decoration: none;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .activity-link:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    
    .activity-slot {
        min-height: 80px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
</style>

<div class="container-fluid my-5 px-4">
    <div asp-validation-summary="ModelOnly" class="alert alert-warning" role="alert"></div>

    <!-- Overskrift -->
    <div class="row mb-4 text-center">
        <div class="col">
            <h1 class="display-4 fw-bold text-success">🏕️ Spejdernes Ugeskema</h1>
            <p class="lead text-muted">Klik på en aktivitet for at se detaljer, hvem der er leder, og tilmelde dig.
            </p>
        </div>
    </div>

    <!-- Det dynamiske ugeskema -->
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">📅 Ugens program</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-striped scout-table m-0 align-middle text-center">
                    <thead class="table-light">
                    <tr>
                        <th style="width: 10%;">Tidspunkt</th>
                        @foreach (var day in Model.Days)
                        {
                            <th style="width: 12.8%;">@day</th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var slot in Model.TimeSlots)
                    {
                        <tr>
                            <!-- Viser tidsrummet i venstre kolonne -->
                            <td class="fw-bold text-secondary text-center">
                                @if (slot == "Formiddag")
                                {
                                    <text>09:00 - 12:00</text>
                                }
                                else if (slot == "Eftermiddag")
                                {

                                    <text>16:30 - 18:30</text>
                                }
                                else if (slot == "Aften")
                                {

                                    <text>19:00 - 21:00</text>
                                }
                            </td>

                            <!-- Looper igennem alle ugens 7 dage for dette tidsrum -->
                            @foreach (var day in Model.Days)
                            {
                                <td>
                                    @* Slår op i din Dictionary for at se, om der er en aktivitet på dette tidspunkt *@
                                    @if (Model.Schedule.TryGetValue((slot, day), out var activity))
                                    {
                                        @* asp-route-id sender automatisk aktivitetens int ID med over i URL'en *@
                                        <a asp-page="/ActivityDetails" asp-route-id="@activity.Id"
                                           class="d-block card activity-link bg-primary text-white p-2">
                                            <div class="activity-slot">
                                                <span class="fw-bold small">@activity.Name</span>
                                                <span class="badge bg-white text-dark btn-sm mt-1">Se info →</span>
                                            </div>
                                        </a>
                                        <form method="post" asp-page-handler="Register" class="mt-1">
                                            <input type="hidden" name="activityId" value="@activity.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                Register
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        @* Hvis der ikke er en aktivitet, viser vi standardtekst eller en streg *@
                                        @if (slot == "Formiddag" && day != "Lørdag" && day != "Søndag")
                                        {
                                            <span class="text-muted small table-light d-block py-3">Skole / Job</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    }
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<hr/>
<h1>Basic Modal</h1> 

<button type="button" class="btn btn-success my-3" data-bs-toggle="modal" data-bs-target="#createActivityModal">
    ➕ Opret ny aktivitet
</button>

<div id="createActivityModal" class="modal fade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Tilføj ny aktivitet</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-page-handler="CreateActivity">
                    
                    <div class="mb-3">
                        <label for="actName" class="form-label fw-bold">Navn på aktiviteten</label>
                        <input type="text" class="form-control" id="actName" name="Name" placeholder="F.eks. Bålhygge" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="actDesc" class="form-label fw-bold">Beskrivelse</label>
                        <textarea class="form-control" id="actDesc" name="description" rows="3" placeholder="Hvad skal spejderne lave?" required></textarea>
                    </div>
                    
                    <div class="row"> 
                        <div class="col-md-6 mb-3">
                            <label for="actDay" class="form-label fw-bold">Ugedag</label>
                            <select class="form-select" id="actDay" name="dayOfWeek" required>
                                @foreach (var day in Model.Days)
                                {
                                    <option value="@day">@day</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="actSlot" class="form-label fw-bold">Tidspunkt</label>
                            <select class="form-select" id="actSlot" name="timeSlot" required>
                                @foreach (var slot in Model.TimeSlots)
                                {
                                    <option value="@slot">@slot</option>
                                }
                            </select>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="minAge" class="form-label fw-bold">Minimumsalder</label>
                            <input type="number" class="form-control" id="minAge" name="MinimumAge" value="6" min="1" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="maxScouts" class="form-label fw-bold">Max deltagere</label>
                            <input type="number" class="form-control" id="maxScouts" name="MaxParticipantNumber" value="20" min="1" required>
                        </div>
                    </div>
                    
  
                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-success">Opret og tilføj til ugeskema 🪵</button>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<div class="dropdown mt-2">
    <button class="btn btn-success dropdown-toggle fw-bold" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        🗑️ Slet en aktivitet
    </button>
    
    <div class="dropdown-menu p-3 shadow" style="min-width: 300px;">
        <form method="post" asp-page-handler="DeleteActivity">
            <div class="mb-3">
                <label for="deleteSelect" class="form-label small fw-bold text-muted">Vælg aktivitet:</label>
                <select class="form-select form-select-sm" id="deleteSelect" name="activityId" required>
                    <option value="" selected disabled>Vælg...</option>
                    @foreach (var item in Model.Schedule.Values)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-danger btn-sm w-100 fw-bold">Bekræft sletning</button>
        </form>
    </div>
</div>