@page
@model PinkScoutApp.Pages.LederCalendar

@{
    Layout = null;
}

<!DOCTYPE html>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<html>

<head>
    <title>LeaderCalendar</title>
</head>

<body>
    <div>
        <form method="post" class="mb-4">
            <div class="mb-3">
                <label for="title" class="form-label">Activity Title</label>
                <input type="text" class="form-control" id="title" name="title" required />
            </div>
            <div class="mb-3">
                <label for="description" class="form-label">Activity Description</label>
                <textarea class="form-control" id="description" name="description" rows="3" required></textarea>
            </div>
            <button type="submit" asp-page-handler="CreateActivity" class="btn btn-primary">Create Activity</button>
        </form>
    </div>
</body>

</html>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<style>
    /* Gør cellerne bredere på mindre skærme, så tabellen ikke bliver mast */
    @@media screen and (max-width: 992px) {

        .scout-table th,
        .scout-table td {
            min-width: 130px;
        }
    }
    
    /* Giver aktivitetskortene en flot animation, når man holder musen over dem */
    .activity-link {
        text-decoration: none;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .activity-link:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    
    .activity-slot {
        min-height: 80px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
</style>

<div class="container-fluid my-5 px-4">
    <!-- Overskrift -->
    <div class="row mb-4 text-center">
        <div class="col">
            <h1 class="display-4 fw-bold text-success">🏕️ Spejdernes Ugeskema</h1>
            <p class="lead text-muted">Klik på en aktivitet for at se detaljer, hvem der er leder, og tilmelde dig.
            </p>
        </div>
    </div>

    <!-- Det dynamiske ugeskema -->
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">📅 Ugens program</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-striped scout-table m-0 align-middle text-center">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 10%;">Tidspunkt</th>
                            @foreach (var day in Model.Days)
                            {
                                <th style="width: 12.8%;">@day</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var slot in Model.TimeSlots)
                        {
                            <tr>
                                <!-- Viser tidsrummet i venstre kolonne -->
                                <td class="fw-bold text-secondary text-center">
                                    @if (slot == "Formiddag")
                                    {
                                        <text>09:00 - 12:00</text>
                                    }
                                    else if (slot == "Eftermiddag")
                                    {

                                        <text>16:30 - 18:30</text>
                                    }
                                    else if (slot == "Aften")
                                    {

                                        <text>19:00 - 21:00</text>
                                    }
                                </td>

                                <!-- Looper igennem alle ugens 7 dage for dette tidsrum -->
                                @foreach (var day in Model.Days)
                                {
                                    <td>
                                        @* Slår op i din Dictionary for at se, om der er en aktivitet på dette tidspunkt *@
                                        @if (Model.Schedule.TryGetValue((slot, day), out var activity))
                                        {
                                            @* asp-route-id sender automatisk aktivitetens int ID med over i URL'en *@
                                            <a asp-page="/ActivityDetails" asp-route-id="@activity.Title"
                                               class="d-block card activity-link bg-primary text-white p-2">
                                                <div class="activity-slot">
                                                    <span class="fw-bold small">@activity.Title</span>
                                                    <span class="badge bg-white text-dark btn-sm mt-1">Se info →</span>
                                                </div>
                                            </a>
                                        }
                                        else
                                        {
                                            @* Hvis der ikke er en aktivitet, viser vi standardtekst eller en streg *@
                                            @if (slot == "Formiddag" && day != "Lørdag" && day != "Søndag")
                                            {
                                                <span class="text-muted small table-light d-block py-3">Skole / Job</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>